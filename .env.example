# Authentication credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Flask secret key (change this in production!)
SECRET_KEY=dev-secret-key-change-in-production

# Optional SMTP for inquiry notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional favicon (URL to an image)
FAVICON_URL=

# Optional REST API / MCP static bearer tokens (comma-separated)
API_TOKENS=

# Public https base URL, e.g. https://verleih.example.com (for the Claude/MCP connector behind a reverse proxy)
PUBLIC_URL=
