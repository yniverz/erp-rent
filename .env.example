# Authentication credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Flask secret key: required, random, at least 32 characters
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cookies are HTTPS-only by default; set COOKIE_SECURE=0 for plain-http local development
# COOKIE_SECURE=0

# Optional SMTP for inquiry notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional fallback favicon URL (better: set it in Admin → Einstellungen)
FAVICON_URL=

# Optional REST API / MCP static bearer tokens (comma-separated)
API_TOKENS=

# Public https base URL, e.g. https://verleih.example.com (for the Claude/MCP connector behind a reverse proxy)
PUBLIC_URL=
