# Docker Environment Variables
# Copy this to .env and update with your values for Docker deployment

SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional SMTP for inquiry notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional fallback favicon URL (better: set it in Admin → Einstellungen)
FAVICON_URL=
